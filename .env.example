# Скопируйте в .env и подставьте свои значения. После изменений перезапустите: npm run dev

# Почта, на которую приходят заявки с формы (FormSubmit: https://formsubmit.co )
# При первом обращении FormSubmit может прислать письмо с подтверждением — откройте ссылку из письма.
VITE_FORM_SUBMIT_EMAIL=you@example.com

# Ссылки на соцсети и Avito (пустая строка = иконка скрыта)
VITE_SOCIAL_AVITO=https://www.avito.ru/user/xxxxxxxx/profile
VITE_SOCIAL_INSTAGRAM=https://www.instagram.com/yourprofile
VITE_SOCIAL_TELEGRAM=https://t.me/yourchannel
VITE_SOCIAL_VK=https://vk.com/yourpage

# Ссылка на Telegram с отзывами (кнопка в блоке «Отзывы клиентов»)
VITE_REVIEWS_TELEGRAM_URL=https://t.me/your_reviews_channel
