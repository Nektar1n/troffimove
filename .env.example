# Скопируйте в .env и подставьте свои значения. После изменений перезапустите: npm run dev

# Заявки с формы: https://web3forms.com — бесплатно, письма на почту (formsubmit.co в РФ часто недоступен).
# 1) Создайте форму, укажите почту получателя  2) Скопируйте Access Key сюда:
VITE_WEB3FORMS_ACCESS_KEY=your-access-key-here

# Почта для ссылки «написать вручную», если форма не отправилась
VITE_CONTACT_EMAIL=you@example.com

# Ссылки на соцсети и Avito (пустая строка = иконка скрыта)
VITE_SOCIAL_AVITO=https://www.avito.ru/user/xxxxxxxx/profile
VITE_SOCIAL_INSTAGRAM=https://www.instagram.com/yourprofile
VITE_SOCIAL_TELEGRAM=https://t.me/yourchannel
VITE_SOCIAL_VK=https://vk.com/yourpage

# Ссылка на Telegram с отзывами (кнопка в блоке «Отзывы клиентов»)
VITE_REVIEWS_TELEGRAM_URL=https://t.me/your_reviews_channel

# GitHub Pages: в репозитории Settings → Secrets → Actions создай секрет с именем DOTENV
# (имя «.env» недопустимо) и вставь сюда же весь текст твоего локального .env одним куском.
